# Phase 0 configuration contract. Values are placeholders only; never commit secrets.

# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_NAME=Detailing Booking
APP_DEFAULT_LOCALE=en-US
APP_DEFAULT_CURRENCY=USD
BUSINESS_TIMEZONE=America/Chicago
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/detailing_app
DATABASE_DIRECT_URL=postgresql://app_user:replace_me@localhost:5432/detailing_app

# Authentication
AUTH_SECRET=replace_with_a_long_random_value
AUTH_TRUST_HOST=false
# Supabase Auth: project URL and publishable key are public; never expose a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://kzfxczncurmhfjclerrd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
DETAILLY_OWNER_EMAIL=owner@example.com
# Optional OAuth providers are added only when approved.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Maps and address autocomplete
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_browser_restricted_key
GOOGLE_MAPS_SERVER_API_KEY=replace_with_server_restricted_key
GOOGLE_MAPS_MAP_ID=

# Payments (test mode for development)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECTED_ACCOUNT_ID=

# Private object uploads (S3-compatible)
UPLOADS_S3_ENDPOINT=
UPLOADS_S3_REGION=us-east-1
UPLOADS_S3_BUCKET=replace_me
UPLOADS_S3_ACCESS_KEY_ID=replace_me
UPLOADS_S3_SECRET_ACCESS_KEY=replace_me
UPLOADS_MAX_BYTES=10485760

# Transactional email
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Bookings <bookings@example.com>
EMAIL_REPLY_TO=support@example.com

# Transactional SMS
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=

# Background jobs / webhook processing
QUEUE_PROVIDER=
QUEUE_CONNECTION_URL=
CRON_AUTH_SECRET=replace_with_a_long_random_value

# Observability
OTEL_SERVICE_NAME=detailing-booking
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
ERROR_TRACKING_DSN=
